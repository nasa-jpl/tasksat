tasknet ZoneTest {
  end = 20;

  timelines {
    x : cumulative [0.0, 200.0] bounds [0.0, 200.0] = 100.0;
  }

  task T {
    duration 5;
    pre {
      x in [90.0, 110.0];
    }
    inv {
      x in [30.0, 200.0];
    }
    post {
      x in [30.0, 50.0];
    }
    impacts {
      pre { x = 40.0; }
      maint { x += 10.0; }
      post { x = 200.0; }
    }
  }
}
