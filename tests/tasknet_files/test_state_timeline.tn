tasknet TestState {
  end = 100;

  timelines {
    power : state(off, on) = off;
  }

  task T {
    duration 10;
    pre {
      power = off;
    }
    inv {
      power = on;
    }
    post {
      power = on;
    }
    impacts {
      pre {
        power = on;
      }
      post {
        power = off;
      }
    }
  }
}
