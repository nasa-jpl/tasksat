tasknet TestPropertyViolation {
  end = 100;

  timelines {
    battery: rate [0.0, 100.0] bounds [0.0, 100.0] = 100.0;
  }

  task drain1 {
    id 1;
    duration 10;
    impacts {
      post { battery +~ -40.0; }
    }
  }

  task drain2 {
    id 2;
    duration 10;
    after drain1;
    impacts {
      post { battery +~ -50.0; }  // This will violate the temporal property
    }
  }

  properties {
    prop battery_safe: always (battery >= 12.0);  // This should be violated
    prop battery_exists: always (battery >= 0.0);  // This should hold
  }
}
