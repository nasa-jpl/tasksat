# Test: Compositional inductive-invariant sequencing (HOLDS case).
#
# A session `Cycle` drives a modal timeline idle -> busy -> idle: activate sets
# mode = busy, deactivate (after activate) sets it back to idle. The invariant
# P = { mode = idle } is claimed to be preserved by one session, hence by any
# sequence of them.
#
# `invariant compositional { mode = idle; }` opts into the check. It desugars to
# `initial { mode = idle; }` + `final within initial;`, so:
#   AA safety           : every valid schedule ends with mode = idle          (holds)
#   AE realizability-P  : from mode = idle, some schedule lands back in idle   (holds)
# => {P}S{P}, so forall N . {P}S^N{P}. Verify with --compositional.
#
# TWENTY chained instances (cycle1 .. cycle20) are present to showcase the point
# of the compositional check: N-independence. Projection reduces the check to ONE
# session instance regardless of N, so verifying that 20-deep chain preserves P
# costs the same as verifying a single session -- the single-session {P}S{P}
# result discharges all 20.

tasknet CompositionalHolds {
  end = 1500;

  timelines {
    mode : state(idle, busy) = idle;
  }

  taskdef Activate {
    duration_range [20, 30];
    impacts {
      post { mode = busy; }
    }
  }

  taskdef Deactivate {
    duration_range [20, 30];
    impacts {
      post { mode = idle; }
    }
  }

  # Session: activate then deactivate.
  taskdef Cycle {
    task activate   : Activate;
    task deactivate : Deactivate { after activate; }
  }

  invariant compositional { mode = idle; }

  task cycle1 : Cycle;
  task cycle2 : Cycle { after cycle1; }
  task cycle3 : Cycle { after cycle2; }
  task cycle4 : Cycle { after cycle3; }
  task cycle5 : Cycle { after cycle4; }
  task cycle6 : Cycle { after cycle5; }
  task cycle7 : Cycle { after cycle6; }
  task cycle8 : Cycle { after cycle7; }
  task cycle9 : Cycle { after cycle8; }
  task cycle10 : Cycle { after cycle9; }
  task cycle11 : Cycle { after cycle10; }
  task cycle12 : Cycle { after cycle11; }
  task cycle13 : Cycle { after cycle12; }
  task cycle14 : Cycle { after cycle13; }
  task cycle15 : Cycle { after cycle14; }
  task cycle16 : Cycle { after cycle15; }
  task cycle17 : Cycle { after cycle16; }
  task cycle18 : Cycle { after cycle17; }
  task cycle19 : Cycle { after cycle18; }
  task cycle20 : Cycle { after cycle19; }
}
