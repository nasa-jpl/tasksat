# Test: 100 nested-session instances to demonstrate compositional N-independence.
#
# 100 mission instances, each containing 2 phases (nested sessions), each
# containing 2 atomic tasks = 400 tasks total. Without compositional reasoning,
# this would be intractable. With --compositional, the check projects to ONE
# mission (4 tasks) and verifies in seconds, discharging all 100.

tasknet HundredMissions {
  end = 10000;

  timelines {
    mode : state(idle, busy) = idle;
  }

  taskdef Prep {
    duration_range [10, 10];
    impacts { post { mode = busy; } }
  }

  taskdef Work {
    duration_range [20, 20];
    impacts { post { mode = idle; } }
  }

  taskdef Phase {
    task prep : Prep;
    task work : Work { after prep; }
  }

  taskdef Mission {
    task phase1 : Phase;
    task phase2 : Phase { after phase1; }
  }

  invariant compositional { mode = idle; }

  task m1 : Mission;
  task m2 : Mission { after m1; }
  task m3 : Mission { after m2; }
  task m4 : Mission { after m3; }
  task m5 : Mission { after m4; }
  task m6 : Mission { after m5; }
  task m7 : Mission { after m6; }
  task m8 : Mission { after m7; }
  task m9 : Mission { after m8; }
  task m10 : Mission { after m9; }
  task m11 : Mission { after m10; }
  task m12 : Mission { after m11; }
  task m13 : Mission { after m12; }
  task m14 : Mission { after m13; }
  task m15 : Mission { after m14; }
  task m16 : Mission { after m15; }
  task m17 : Mission { after m16; }
  task m18 : Mission { after m17; }
  task m19 : Mission { after m18; }
  task m20 : Mission { after m19; }
