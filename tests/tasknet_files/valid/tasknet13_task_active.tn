# Test automatic task state timeline generation
# Demonstrates the __taskname_active automatic timeline feature

tasknet TaskActiveTest {
  end = 100;

  timelines {
    A : atomic = 0;
  }

  task T1 {
    id 1;
    duration 20;
    start 10;

    impacts {
      maint {
        A += 1;
      }
    }
  }

  task T2 {
    id 2;
    duration 15;
    start 50;
    after T1;  # T2 must start after T1 ends

    impacts {
      maint {
        A += 1;
      }
    }
  }

  properties {
    # While T1 is active, A must be 1
    prop p1: always (__T1_active = 1 -> A = 1);

    # While T2 is active, A must be 1
    prop p2: always (__T2_active = 1 -> A = 1);

    # T1 and T2 never overlap (enforced by 'after' dependency)
    prop p3: always (__T1_active = 1 -> __T2_active = 0);

    # T1 eventually becomes active
    prop p4: eventually __T1_active = 1;

    # T2 eventually becomes active
    prop p5: eventually __T2_active = 1;
  }
}
