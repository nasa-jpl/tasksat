tasknet ZoneMixed {
  end = 50;

  timelines {
    x : cumulative [0.0, 200.0] bounds [0.0, 200.0] = 100.0;
    y : rate [0.0, 200.0] bounds [0.0, 200.0] = 80.0;
  }

  task T {
    duration 10;
    impacts {
      pre {
        x = 40.0;
        y = 60.0;
      }
      maint {
        x += 10.0;
        y +~ -2.0;
      }
      post {
        x = 150.0;
        y = 100.0;
      }
    }
  }
}
